# Copie para .env e preencha. O .env fica fora do git.
# Valores do SIMPlay 1.4.1 (ver docs/protocol/).

# ClientId OAuth de produção (ServiceConstants.cs).
INTEL_SIAM_CLIENT_ID=
# CLOUD_SERVER_KEY e CLOUD_SERVER_PWD (TunnelingService.cs).
INTEL_SIAM_T2U_KEY=
INTEL_SIAM_T2U_PASSWORD=
# Caminho da libt2u.so do SIMPlay.
INTEL_SIAM_LIBT2U=
# Opcional: caminho do ffmpeg.
# INTEL_SIAM_FFMPEG=
